rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validProfile() {
        let profile = request.resource.data;
        return profile.keys().hasOnly([
          'loginId', 'email', 'nickname', 'homeAddress', 'photo', 'preferences'
        ])
        && profile.loginId is string
        && profile.loginId.matches('^[a-zA-Z0-9]{4,20}$')
        && request.auth.token.email == profile.loginId.lower() + '@planit-id.invalid'
        && profile.email is string
        && profile.email.size() <= 254
        && profile.nickname is string
        && profile.nickname.size() >= 1
        && profile.nickname.size() <= 20
        && profile.homeAddress is string
        && profile.preferences is map
        && (profile.photo == null ||
          (profile.photo is bytes && profile.photo.size() <= 768000));
      }

      allow get: if isOwner();
      allow create: if isOwner() && validProfile();
      allow update: if isOwner() && validProfile()
        && request.resource.data.loginId == resource.data.loginId
        && request.resource.data.email == resource.data.email;
    }
  }
}
